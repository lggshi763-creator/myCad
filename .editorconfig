# EditorConfig — see https://editorconfig.org
# Spec: docs/architecture/08-vs-toolchain.md §8.6.3

root = true

[*]
indent_style              = space
indent_size               = 4
end_of_line               = lf
insert_final_newline      = true
trim_trailing_whitespace  = true
charset                   = utf-8
max_line_length           = 100

# C / C++ / FlatBuffers — 4 spaces (project default; explicit for clarity)
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inl,ipp,fbs}]
indent_size               = 4

# CMake — 2 spaces
[CMakeLists.txt]
indent_size               = 2

[*.cmake]
indent_size               = 2

# JSON / YAML / TOML — 2 spaces
[*.{json,yml,yaml,toml}]
indent_size               = 2

# Markdown — 2 spaces, preserve trailing whitespace (used for hard line breaks)
[*.md]
indent_size               = 2
trim_trailing_whitespace  = false
max_line_length           = off

# Qt UI / QRC — 2 spaces (matches Designer output)
[*.{ui,qrc,ts}]
indent_size               = 2

# Windows shell scripts must keep CRLF for cmd.exe
[*.{bat,cmd,ps1}]
end_of_line               = crlf

# Makefiles require tab indentation
[{Makefile,makefile,*.mk}]
indent_style              = tab
indent_size               = 4
