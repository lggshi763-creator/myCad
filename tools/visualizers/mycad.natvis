<?xml version="1.0" encoding="utf-8"?>
<!--
  myCad Visual Studio debugger visualizers.
  Spec: docs/architecture/08-vs-toolchain.md §8.4.2

  How VS picks this up:
    Visual Studio scans every directory under the source tree (and the build
    binary dir) for *.natvis files at debug-session start. No CMake wiring is
    required — placing the file at tools/visualizers/mycad.natvis is enough.

    If you ever need to force-load it (e.g., when debugging a target whose
    source dir doesn't include this file), add:
        target_sources(<target> PRIVATE
            ${PROJECT_SOURCE_DIR}/tools/visualizers/mycad.natvis)

  How to add a new entry:
    1. Define the type in src/.
    2. In a debug session, expand a variable of that type in the Watch / Locals
       window — note the field names VS shows.
    3. Add a <Type Name="..."> below following the pattern.
    4. Save and continue debugging — VS reloads natvis on the fly without
       restarting the session (Tools -> Options -> Debugging -> 'Enable Edit
       and Continue' must be on, but is by default).

  Notes:
    - Entries below correspond to types that shipped in Sprint 0.2.
    - When MSVC STL internals change between toolset versions, array/vector
      accessors can break. Verify after every VS update.
-->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!-- ====================================================================
       Identity types (Sprint 0.2)
       ==================================================================== -->

  <!--
    EventId — 128-bit event identity stored as std::array<uint8_t, 16>.
    The ,x format renders each byte as two hex digits (lowercase).
  -->
  <Type Name="mycad::domain::EventId">
    <DisplayString>{bytes[0],x}{bytes[1],x}{bytes[2],x}{bytes[3],x}-{bytes[4],x}{bytes[5],x}-{bytes[6],x}{bytes[7],x}-{bytes[8],x}{bytes[9],x}-{bytes[10],x}{bytes[11],x}{bytes[12],x}{bytes[13],x}{bytes[14],x}{bytes[15],x}</DisplayString>
    <Expand>
      <Item Name="bytes">bytes</Item>
    </Expand>
  </Type>

  <Type Name="mycad::domain::AggregateId">
    <DisplayString>{bytes[0],x}{bytes[1],x}{bytes[2],x}{bytes[3],x}-{bytes[4],x}{bytes[5],x}-{bytes[6],x}{bytes[7],x}-{bytes[8],x}{bytes[9],x}-{bytes[10],x}{bytes[11],x}{bytes[12],x}{bytes[13],x}{bytes[14],x}{bytes[15],x}</DisplayString>
    <Expand>
      <Item Name="bytes">bytes</Item>
    </Expand>
  </Type>

  <Type Name="mycad::domain::SketchId">
    <DisplayString>{bytes[0],x}{bytes[1],x}{bytes[2],x}{bytes[3],x}-{bytes[4],x}{bytes[5],x}-{bytes[6],x}{bytes[7],x}-{bytes[8],x}{bytes[9],x}-{bytes[10],x}{bytes[11],x}{bytes[12],x}{bytes[13],x}{bytes[14],x}{bytes[15],x}</DisplayString>
    <Expand>
      <Item Name="bytes">bytes</Item>
    </Expand>
  </Type>

  <Type Name="mycad::domain::Version">
    <DisplayString Condition="value == 0">v0 (initial)</DisplayString>
    <DisplayString>v{value}</DisplayString>
    <Expand>
      <Item Name="value">value</Item>
    </Expand>
  </Type>

  <!-- ====================================================================
       Geometry value objects (Sprint 0.2)
       ==================================================================== -->

  <Type Name="mycad::domain::Point2D">
    <DisplayString>({x,g}, {y,g})</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
    </Expand>
  </Type>

  <Type Name="mycad::domain::Point3D">
    <DisplayString>({x,g}, {y,g}, {z,g})</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
      <Item Name="z">z</Item>
    </Expand>
  </Type>

  <Type Name="mycad::domain::Vector3D">
    <DisplayString>&lt;{x,g}, {y,g}, {z,g}&gt;</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
      <Item Name="z">z</Item>
    </Expand>
  </Type>

  <Type Name="mycad::domain::Axis3D">
    <DisplayString>Axis{{ origin=({origin.x,g}, {origin.y,g}, {origin.z,g}), dir=&lt;{direction.x,g}, {direction.y,g}, {direction.z,g}&gt; }}</DisplayString>
    <Expand>
      <Item Name="origin">origin</Item>
      <Item Name="direction">direction</Item>
    </Expand>
  </Type>

  <Type Name="mycad::domain::BoundingBox">
    <DisplayString>BB{{ min=({min.x,g},{min.y,g},{min.z,g}), max=({max.x,g},{max.y,g},{max.z,g}) }}</DisplayString>
    <Expand>
      <Item Name="min">min</Item>
      <Item Name="max">max</Item>
    </Expand>
  </Type>

  <!--
    Transform3D — row-major 4x4 affine matrix (field: m[16]).
    DisplayString shows translation (column 3: m[3], m[7], m[11]) for quick
    orientation; Expand shows the full matrix row-by-row.
  -->
  <Type Name="mycad::domain::Transform3D">
    <DisplayString>Transform3D{{ t=({m[3],g}, {m[7],g}, {m[11],g}) }}</DisplayString>
    <Expand>
      <Item Name="row0">"[{m[0],g}  {m[1],g}  {m[2],g}  {m[3],g}]"</Item>
      <Item Name="row1">"[{m[4],g}  {m[5],g}  {m[6],g}  {m[7],g}]"</Item>
      <Item Name="row2">"[{m[8],g}  {m[9],g}  {m[10],g}  {m[11],g}]"</Item>
      <Item Name="row3">"[{m[12],g}  {m[13],g}  {m[14],g}  {m[15],g}]"</Item>
      <Item Name="raw">m</Item>
    </Expand>
  </Type>

  <!-- ====================================================================
       Domain events (Sprint 0.2)
       ==================================================================== -->

  <!--
    DomainEvent base — shows aggregate version and timestamp.
    typeName() is virtual so cannot be called directly in natvis; use
    the Expand section to see the concrete subclass via [base class] node.
  -->
  <Type Name="mycad::domain::DomainEvent">
    <DisplayString>DomainEvent{{ ver={aggregateVersion_.value}, ts={occurredAtMs_} }}</DisplayString>
    <Expand>
      <Item Name="eventId">eventId_</Item>
      <Item Name="aggregateId">aggregateId_</Item>
      <Item Name="version">aggregateVersion_</Item>
      <Item Name="occurredAtMs">occurredAtMs_</Item>
    </Expand>
  </Type>

  <!-- ====================================================================
       Aggregates (Sprint 0.3+)
       ==================================================================== -->

  <!--
    Sketch aggregate — display id + entity count + version. The expression
    inside ${...} for the entity count uses MSVC STL internals which may
    change between v14.50 and future toolsets; verify after every VS update.
  -->
  <!--
  <Type Name="mycad::domain::sketch::Sketch">
    <DisplayString>
      Sketch{{ id={id_,sb}, entities={entities_._Mypair._Myval2._Mylast - entities_._Mypair._Myval2._Myfirst}, version={version_.value} }}
    </DisplayString>
    <Expand>
      <Item Name="id">id_</Item>
      <Item Name="version">version_</Item>
      <Item Name="entities">entities_</Item>
      <Item Name="constraints">constraints_</Item>
    </Expand>
  </Type>
  -->

  <!-- ====================================================================
       tl::expected — gives a useful summary instead of raw discriminator.
       Activate when first usage lands.
       ==================================================================== -->

  <!--
  <Type Name="tl::expected&lt;*,*&gt;">
    <DisplayString Condition="m_has_val">Ok{{ {m_val} }}</DisplayString>
    <DisplayString>Err{{ {m_unexpect.m_val} }}</DisplayString>
    <Expand>
      <Item Name="value" Condition="m_has_val">m_val</Item>
      <Item Name="error" Condition="!m_has_val">m_unexpect.m_val</Item>
    </Expand>
  </Type>
  -->

</AutoVisualizer>
